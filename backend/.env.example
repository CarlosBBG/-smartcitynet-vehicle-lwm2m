NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://smartcitynet:smartcitynet@127.0.0.1:5432/smartcitynet

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=replace-this-laboratory-password
ADMIN_INITIAL_NAME=Administrador SmartCityNet

BRIDGE_URL=http://127.0.0.1:8081
BRIDGE_SYNC_INTERVAL_MS=2000
LESHAN_URL=http://127.0.0.1:8080
LWM2M_MANAGER_URL=http://127.0.0.1:8090
LWM2M_RECONCILE_INTERVAL_MS=5000
LWM2M_REGISTRATION_GRACE_MS=15000
LWM2M_RETRY_BASE_MS=5000
LWM2M_RETRY_MAX_MS=60000

OFFLINE_THRESHOLD_SECONDS=120
LOW_BATTERY_THRESHOLD=20
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
# Para acceso LAN, agregue también http://IP_DEL_PC:5173 a FRONTEND_URL.
